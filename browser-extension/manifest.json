{
  "manifest_version": 3,
  "name": "TwinFile Rust 下载接管",
  "version": "1.0.0",
  "description": "把 HTTP(S) 下载链接交给 TwinFile Rust，让用户选择保存位置。",
  "permissions": ["downloads", "nativeMessaging", "contextMenus", "storage"],
  "action": {"default_title": "TwinFile Rust", "default_popup": "popup.html"},
  "background": {"service_worker": "background.js"}
}
